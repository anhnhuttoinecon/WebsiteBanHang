@model WebsiteBanHang.Models.Product

<h2 class="mt-4 mb-3 text-danger">Xóa sản phẩm</h2>

<h3>Bạn có chắc chắn muốn xóa sản phẩm này không? Hành động này không thể hoàn tác.</h3>
<div class="mt-4">
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Giá tiền</dt>
        <dd class="col-sm-9">@Model.Price.ToString("#,##0") VNĐ</dd>

        <dt class="col-sm-3">Danh mục</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
    </dl>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>