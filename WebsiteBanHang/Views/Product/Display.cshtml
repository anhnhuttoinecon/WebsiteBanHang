@model WebsiteBanHang.Models.Product

<h2 class="mt-4 mb-3">Chi tiết sản phẩm</h2>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Giá tiền</dt>
        <dd class="col-sm-9">@Model.Price.ToString("#,##0") VNĐ</dd>

        <dt class="col-sm-3">Mô tả</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Danh mục</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">Sửa thông tin</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>