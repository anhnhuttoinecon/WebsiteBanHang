@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    @model WebsiteBanHang.Models.Category

    <h2 class="mt-4 mb-3">Chi tiết danh mục</h2>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Mã danh mục (ID)</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Tên danh mục</dt>
            <dd class="col-sm-9">@Model.Name</dd>
        </dl>
    </div>

    <div class="mt-3">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">Sửa thông tin</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
}
